# Скопируй этот файл в .env и заполни.

# Токен из @BotFather
BOT_TOKEN=

# Твой Telegram user id. Сюда бот заливает бланки и подписанные копии.
# Узнать: @userinfobot или /status после запуска (не сработает без id).
OWNER_ID=

# Необязательно: отдельный чат/канал для бланков и архива.
# По умолчанию используется OWNER_ID. Можно указать @channel или -100...
STORAGE_CHAT_ID=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
